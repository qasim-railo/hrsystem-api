{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "RootPath": "PrivateStorage",
    "MaxFileSizeBytes": 26214400
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HRSystem;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_SECURE_RANDOM_256BIT_KEY_FOR_ENVIRONMENT",
    "Issuer": "HRSystem",
    "Audience": "HRSystemUsers",
    "ExpiresInMinutes": 20
  },
  "Cloudinary": {
    "CloudName": "REPLACE_WITH_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "REPLACE_WITH_CLOUDINARY_API_KEY",
    "ApiSecret": "REPLACE_WITH_CLOUDINARY_API_SECRET",
    "ApiEnvVariable": "CLOUDINARY_URL=REPLACE_WITH_ENVIRONMENT_VALUE"
  }
}
